{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "case_revision": {
      "title": "case-revision",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "case_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "data_kind": {
          "type": "string",
          "enum": [
            "research",
            "synthetic_fixture"
          ]
        },
        "analysis_intent": {
          "type": "string",
          "enum": [
            "increase_exposure",
            "target_release_profile",
            "bioequivalence_screen",
            "stability",
            "manufacturability",
            "exploratory"
          ]
        },
        "route": {
          "type": "string",
          "enum": [
            "oral",
            "intravenous",
            "intramuscular",
            "subcutaneous",
            "other",
            "unknown"
          ]
        },
        "population": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "defined",
                "unknown"
              ]
            },
            "description": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "required": [
            "status",
            "description"
          ],
          "additionalProperties": false
        },
        "identity": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "resolved",
                "molecule_only",
                "ambiguous",
                "unresolved"
              ]
            },
            "molecular_entity_ref": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "substance_form_ref": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "product_revision_ref": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "required": [
            "status",
            "molecular_entity_ref",
            "substance_form_ref",
            "product_revision_ref"
          ],
          "additionalProperties": false
        },
        "composition_completeness": {
          "type": "string",
          "enum": [
            "complete_quantitative",
            "qualitative_only",
            "partial",
            "unknown"
          ]
        },
        "dose": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "known",
                "unknown",
                "not_applicable"
              ]
            },
            "amount": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "basis": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          },
          "required": [
            "status",
            "amount",
            "unit",
            "basis"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "known"
                  }
                }
              },
              "then": {
                "properties": {
                  "amount": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "else": {
                "properties": {
                  "amount": {
                    "type": "null"
                  },
                  "unit": {
                    "type": "null"
                  },
                  "basis": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "level": {
                "type": "string",
                "enum": [
                  "hard",
                  "preference"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "origin_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "level",
              "statement",
              "origin_ref"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "external_processing_allowed": {
          "type": "boolean"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "schema_version",
        "case_id",
        "case_revision_id",
        "workspace_id",
        "data_kind",
        "analysis_intent",
        "route",
        "population",
        "identity",
        "composition_completeness",
        "dose",
        "requirements",
        "external_processing_allowed",
        "source_refs",
        "created_at"
      ],
      "additionalProperties": false
    },
    "user_messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "const": "user"
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "dossier": {
      "type": "object",
      "properties": {
        "card_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "observation_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "additional_inputs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "card_refs",
        "observation_refs",
        "additional_inputs"
      ],
      "additionalProperties": false
    },
    "requested_output_format": {
      "const": "benchmark_response_v1"
    }
  },
  "required": [
    "case_id",
    "case_revision",
    "user_messages",
    "dossier",
    "requested_output_format"
  ],
  "additionalProperties": false
}
