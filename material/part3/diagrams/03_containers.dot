digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.30", ranksep="0.55", splines=polyline, fontname="DejaVu Sans", fontsize=18, labelloc="t", label="Исполняемые части и хранилища", dpi=140];
node [shape=box, style="rounded,filled", fillcolor="#f5f5f5", color="#555555", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.12"];
edge [fontname="DejaVu Sans", fontsize=10, color="#555555", arrowsize=0.7];
edge [constraint=false];
{rank=same; api; pg; blob;}
{rank=same; fetch; chem; r; llm;}
{rank=same; ext; obs;}
ui -> api -> worker -> fetch -> ext [style=invis, constraint=true, weight=20];
ui [label="Браузерный интерфейс\nне хранит секреты источников"];
api [label="Backend / модульный монолит\nконтракты, права, версии, бизнес-логика"];
pg [label="PostgreSQL\nкейсы, наблюдения, задачи, метаданные"];
blob [label="Файловое / объектное хранилище\nснимки и неизменяемые артефакты"];
worker [label="Worker процессов\nlease, retry, fencing, бюджет"];
fetch [label="Изолированный загрузчик / parser\nквоты, карантин, ограничения сети"];
chem [label="Изолированный расчётный процесс\nRDKit и выбранные предикторы"];
r [label="Опциональный R/.NET runner\nOSPSuite-R, закреплённый образ"];
llm [label="LLM gateway\nполитики данных, схемы, лимиты"];
ext [label="Разрешённые внешние сервисы\nпубличные API / модельный провайдер"];
obs [label="Техническая наблюдаемость\nбез полного частного содержимого"];
ui -> api [label="HTTPS"];
api -> pg;
api -> blob;
worker -> pg;
worker -> blob;
worker -> fetch;
worker -> chem;
worker -> r;
worker -> llm;
fetch -> ext;
llm -> ext;
api -> obs;
worker -> obs;
ui [pos="500,780!"];
api [pos="500,640!"];
pg [pos="160,480!"];
worker [pos="500,480!"];
blob [pos="840,480!"];
fetch [pos="160,300!"];
chem [pos="500,300!"];
r [pos="840,300!"];
llm [pos="160,110!"];
ext [pos="500,110!"];
obs [pos="840,110!"];
}