digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.30", ranksep="0.55", splines=polyline, fontname="DejaVu Sans", fontsize=18, labelloc="t", label="Происхождение и пересмотр без потери истории", dpi=140];
node [shape=box, style="rounded,filled", fillcolor="#f5f5f5", color="#555555", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.12"];
edge [fontname="DejaVu Sans", fontsize=10, color="#555555", arrowsize=0.7];
s1 [label="Снимок источника v1\nконтент + hash + права"];
o1 [label="Наблюдение v1\nточное место в снимке"];
a1 [label="Оценка v1\nусловия и расчётные входы"];
r1 [label="Принятый отчёт v1\nне переписывается"];
s2 [label="Новый снимок v2\nобнаружено изменение"];
impact [label="Проверка влияния\nчто изменилось по смыслу"];
o2 [label="Новая версия наблюдения\nили сохранение прежней"];
a2 [label="Новая оценка\nтолько затронутые зависимости"];
review [label="Повторное рассмотрение\nсравнение v1 / v2"];
r2 [label="Отчёт v2 + связь с v1\nоснование пересмотра"];
s1 -> o1 [label="извлечено из"];
o1 -> a1 [label="использовано"];
a1 -> r1 [label="основание решения"];
s1 -> s2 [label="новая версия источника"];
s2 -> impact;
impact -> o2 [label="семантическое изменение"];
o2 -> a2;
a2 -> review;
r1 -> review [label="историческое сравнение"];
review -> r2 [label="новое решение"];
}