digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.30", ranksep="0.55", splines=polyline, fontname="DejaVu Sans", fontsize=18, labelloc="t", label="Основные предметные сущности и ссылки", dpi=140];
node [shape=box, style="rounded,filled", fillcolor="#f5f5f5", color="#555555", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.12"];
edge [fontname="DejaVu Sans", fontsize=10, color="#555555", arrowsize=0.7];
tenant [label="Workspace / Project\nграница полномочий"];
case [label="Case → CaseRevision\nцель, доза, путь, популяция"];
mol [label="MolecularEntity\nисходная и нормализованная структура"];
form [label="SubstanceForm\nсоль / полиморф / гидрат / состояние"];
prod [label="ProductRevision\nрынок, производитель, состав"];
source [label="SourceRecord → SourceSnapshot\nверсия, права, hash"];
ev [label="EvidenceSpan\nстраница / раздел / диапазон / таблица"];
ob [label="Observation\nзначение, условия, метод, статус"];
run [label="CalculationRun / SimulationRun\nвходы, версия, выходы"];
claim [label="Claim / Assessment\nподдержка, конфликт, неопределённость"];
cand [label="CandidateRevision\nизменение, ограничения, проверки"];
dec [label="ReviewDecision → ReportBundle\nзафиксированный набор версий"];
tenant -> case [label="1:N"];
case -> prod [label="ссылка на выбранную версию"];
prod -> form [label="связь с субстанцией"];
form -> mol [label="связь, не тождество"];
source -> ev [label="1:N"];
ev -> ob [label="поддерживает"];
ob -> claim [label="основание"];
ob -> run [label="вход"];
run -> claim [label="расчётное основание"];
claim -> cand [label="обоснование"];
case -> cand [label="1:N"];
cand -> dec [label="оценённая версия"];
source -> dec [label="manifest снимков"];
}