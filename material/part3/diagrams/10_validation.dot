digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.30", ranksep="0.55", splines=polyline, fontname="DejaVu Sans", fontsize=18, labelloc="t", label="Допуск версии и научное подтверждение — разные контуры", dpi=140];
node [shape=box, style="rounded,filled", fillcolor="#f5f5f5", color="#555555", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.12"];
edge [fontname="DejaVu Sans", fontsize=10, color="#555555", arrowsize=0.7];
change [label="Изменение кода / модели / правил\nновая неизменяемая версия"];
tech [label="Контрактные, модульные\nи adversarial-тесты"];
domain [label="Предметный benchmark\nзамороженные данные и базовые линии"];
assess [label="Разбор ошибок и применимости\nкритерии приняты до просмотра теста"];
release [label="Допуск версии\nв объявленный ограниченный контекст"];
use [label="Работа эксперта\nс фиксацией ошибок и исправлений"];
hyp [label="Принятая гипотеза\nплан эксперимента"];
lab [label="Новый эксперимент\nи независимое подтверждение"];
newdata [label="Проверенные новые наблюдения\nне автоматическое переобучение"];
change -> tech;
tech -> domain [label="технический минимум пройден"];
domain -> assess;
assess -> release [label="критерии соблюдены"];
assess -> change [label="требуется исправление"];
release -> use;
use -> hyp [label="эксперт принял"];
hyp -> lab;
lab -> newdata [label="контроль данных"];
newdata -> change [label="отдельное решение о новой версии"];
use -> change [label="ошибки в отдельной выборке"];
}