digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.30", ranksep="0.55", splines=polyline, fontname="DejaVu Sans", fontsize=18, labelloc="t", label="Целостный процесс: от вопроса к проверяемому решению", dpi=140];
node [shape=box, style="rounded,filled", fillcolor="#f5f5f5", color="#555555", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.12"];
edge [fontname="DejaVu Sans", fontsize=10, color="#555555", arrowsize=0.7];
input [label="Вопрос специалиста\nпрепарат, цель, ограничения"];
id [label="Проверка идентичности\nвещества и продукта"];
fix [label="Зафиксировать версию кейса\nобласть применения и права"];
ask [label="Уточнение неоднозначности\nили границ задачи"];
collect [label="Источники → извлечение\n→ проверка наблюдений"];
profile [label="Профиль и гипотезы\nоб ограничивающих факторах"];
cand [label="Каталог стратегий\n→ кандидаты"];
checks [label="Состав, стабильность, производство\nконтекстные и регуляторные проверки"];
extra [label="Дополнительный расчёт\nPBPK или химическая модификация"];
board [label="Сравнение вариантов\nдоказательства + пробелы + следующий опыт"];
review [label="Экспертное решение\nпринять / уточнить / отклонить"];
report [label="Зафиксированный отчёт\nверсии, ссылки, ограничения"];
exp [label="Внешний эксперимент\nи импорт фактических результатов"];
input -> id;
id -> ask [label="неоднозначно"];
ask -> input [label="новые сведения"];
id -> fix [label="объект определён"];
fix -> collect;
collect -> profile;
profile -> cand;
cand -> checks;
checks -> extra [label="есть основания и данные"];
extra -> board;
checks -> board [label="без лишнего расчёта"];
board -> review;
review -> report [label="принято в заданных границах"];
review -> ask [label="нужны уточнения"];
report -> exp [label="план проверки"];
exp -> fix [label="новая версия, не перезапись"];
}