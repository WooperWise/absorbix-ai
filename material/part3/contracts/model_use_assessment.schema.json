{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pharma-diploma:model-use-assessment:1.0.0",
  "title": "model-use-assessment",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "case_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "model_ref": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "question_of_interest": {
      "type": "string",
      "minLength": 1
    },
    "context_of_use": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "screening",
        "ranking",
        "quantitative_prediction",
        "scenario_exploration"
      ]
    },
    "model_influence": {
      "type": "string",
      "minLength": 1
    },
    "consequence_of_wrong_decision": {
      "type": "string",
      "minLength": 1
    },
    "risk_rationale": {
      "type": "string",
      "minLength": 1
    },
    "input_domain_description": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "validation_evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "decision": {
      "type": "string",
      "enum": [
        "not_assessed",
        "insufficient",
        "outside_scope",
        "fit_for_context"
      ]
    },
    "reviewer_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "assessment_id",
    "workspace_id",
    "case_revision_id",
    "model_ref",
    "model_version",
    "question_of_interest",
    "context_of_use",
    "role",
    "model_influence",
    "consequence_of_wrong_decision",
    "risk_rationale",
    "input_domain_description",
    "evaluation_criteria",
    "validation_evidence_refs",
    "limitations",
    "decision",
    "reviewer_ref",
    "created_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "fit_for_context"
          }
        }
      },
      "then": {
        "properties": {
          "validation_evidence_refs": {
            "minItems": 1
          },
          "reviewer_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
